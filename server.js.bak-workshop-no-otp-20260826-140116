  const exclusionSources =
    getProcessAnalysisExclusionSources(
      context.submission,
      context.studentProfile
    );

  const analysis =
    analyzeSubmission(
      context.submission,
      context.assignment,
      {
        excludedFromAnalytics:
          exclusionSources.length > 0,

        exclusionSources,
      }
    );

  const inputHash =
    getSubmissionProcessInputHash(
      context.submission,
      context.assignment,
      context.studentProfile
    );

  const payload =
    buildProcessAnalysisPayload({
      submission:
        context.submission,

      assignment:
        context.assignment,

      profile:
        context.studentProfile,

      analysis,

      inputHash,
