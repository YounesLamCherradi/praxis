      return res.status(400).json({
        error:
          writeError.message,
      });
    }

    await enqueueSubmissionStatusNotifications(
      null,
      created
    );

    processNotificationOutbox()
      .catch(
        (notifyError) => {
          console.error(
            'Student review outbox processing failed:',
            notifyError
          );
        }
      );

    return res.json({
      submission: created,
    });

  } catch (error) {
    return res.status(500).json({
      error: error.message,
    });
  }
});

