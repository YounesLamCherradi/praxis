      });
    }

    const insertResult =
      await db.query(
        `INSERT INTO public.submissions
          (
            assignment_id,
            student_id,
            started_at
          )
         VALUES ($1, $2, NOW())
         ON CONFLICT
          (assignment_id, student_id)
         DO NOTHING
         RETURNING *`,
        [
          req.params.assignmentId,
          user.id,
        ]
      );

    let data =
      insertResult.rows[0];

    if (data) {
      await saveSubmissionRevision(
        data,
        user.id,
        'started'
      );

    } else {
      const raceResult =
        await db.query(
          `SELECT *
             FROM public.submissions
            WHERE assignment_id = $1
